{
    "layer": "top",
    "position": "left",

    "modules-left": [
        "custom/launcher",
        "niri/window",
    ],

    "modules-center": [
        "niri/workspaces"
    ],

    "modules-right": [
        "group/quick-settings",
        "cava"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "on-click-right": "fuzzel-logout-menu"
    },
    "niri/workspaces": {
        "format": "{index}"
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 30,
        "rotate": 90
    },

    "group/quick-settings": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 300,
            "children-class": "quick-settings-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/expand-icon",
            "idle_inhibitor",
            "cpu",
            "memory",
            "temperature",
            "battery",
            "custom/network",
            "backlight",
            "wireplumber#sink",
            "wireplumber#source"
        ],
    },
    "custom/expand-icon": {
        "format": "",
        "tooltip": false,
        "rotate": 270
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip-format-activated": "Idle inhibitor: on",
        "tooltip-format-deactivated": "Idle inhibitor: off"
    },
    "cpu": {
        "format": "",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "on-click-right": "foot btop"
    },
    "memory": {
        "format": "",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "on-click-right": "foot btop"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 75,
        "format": "{icon}",
        "format-icons": [ "", "", "", "", "" ],
        "tooltip-format": "{temperatureC}°C"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󰂄",
        "format-plugged": "",
        "format-full": "󰁹",
        "tooltip-format": "{capacity}% ({timeTo})",
        "on-update": "bash -c 'if [ \"{status}\" = \"Discharging\" ] && [ {capacity} -le 20 ]; then notify-send -u critical -h string:x-canonical-private-synchronous:bat-notify \"Battery Low\" \"Level at {capacity}%\"; elif [ \"{status}\" = \"Full\" ] || [ {capacity} -ge 99 ]; then notify-send -u normal -h string:x-canonical-private-synchronous:bat-notify \"Battery Charged\" \"Battery is fully charged!\"; fi'"
    },
    "custom/network": {
        "exec": "network-script",
        "return-type": "json",
        "restart-interval": 2,
        "format": "{}",
        "on-click-right": "nm-connection-editor"
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰛩", "󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"],
        "tooltip-format": "Brightness: {percent}%"
    },
    "wireplumber#sink": {
        "format": "{icon}",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "format-muted": "󰖁",
        "tooltip-format": "Volume: {volume}%",
        "on-click-right": "pwvucontrol"
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "󰍬",
        "format-muted": "󰍭",
        "on-click-right": "pwvucontrol"
    },
    "cava": {
        "framerate": 60,
        "autosens": 1,
        "bars": 14,
        "bar_delimiter": 0,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pipewire",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "format-icons" : [" ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "rotate": 90
    },
}

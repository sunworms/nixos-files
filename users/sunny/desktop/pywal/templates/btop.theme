# Pywal template for btop (Transparent + High Contrast)
#
# Palette notes: pywal sorts accents dark -> light (color1 darkest, color6
# lightest), so graphs ramp color4 -> color6 and get brighter as load rises.

# Main background, empty for terminal transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="{foreground}"

# Title color for boxes
theme[title]="{color6}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{color6}"

# Selected row in the process list: dark accent fill, light text
theme[selected_bg]="{color3}"
theme[selected_fg]="{foreground}"

# Inactive/disabled text (dim, not full foreground)
theme[inactive_fg]="{color8}"

# Text drawn over graphs, and the empty part of meters
theme[graph_text]="{foreground}"
theme[meter_bg]="{color8}"

# Misc colors for processes box (mini graphs, status)
theme[proc_misc]="{color6}"

# Box outlines: one accent per section
theme[cpu_box]="{color4}"
theme[mem_box]="{color5}"
theme[net_box]="{color6}"
theme[proc_box]="{color4}"

# Box divider line
theme[div_line]="{color8}"

# Temperature graph colors
theme[temp_start]="{color4}"
theme[temp_mid]="{color5}"
theme[temp_end]="{color6}"

# CPU graph colors
theme[cpu_start]="{color4}"
theme[cpu_mid]="{color5}"
theme[cpu_end]="{color6}"

# Mem/Disk free meter
theme[free_start]="{color2}"
theme[free_mid]=""
theme[free_end]="{color4}"

# Mem/Disk cached meter
theme[cached_start]="{color3}"
theme[cached_mid]=""
theme[cached_end]="{color5}"

# Mem/Disk available meter
theme[available_start]="{color3}"
theme[available_mid]=""
theme[available_end]="{color6}"

# Mem/Disk used meter
theme[used_start]="{color4}"
theme[used_mid]=""
theme[used_end]="{color6}"

# Download graph colors
theme[download_start]="{color3}"
theme[download_mid]="{color4}"
theme[download_end]="{color6}"

# Upload graph colors
theme[upload_start]="{color3}"
theme[upload_mid]="{color5}"
theme[upload_end]="{color6}"

# Process list gradient (newer btop versions)
theme[process_start]="{color4}"
theme[process_mid]="{color5}"
theme[process_end]="{color6}"

set default-bg "{{ colors.surface.default.rgba | set_alpha: 0.85 }}"
set render-loading-bg "{{ colors.surface.default.rgba | set_alpha: 0.85 }}"

set statusbar-bg "{{ colors.surface_container.default.rgba | set_alpha: 0.85 }}"
set inputbar-bg "{{ colors.surface_container.default.rgba | set_alpha: 0.85 }}"
set inputbar-fg "{{ colors.primary.default.rgba }}"

set index-bg "{{ colors.surface.default.rgba | set_alpha: 0.85 }}"

set index-active-bg "{{ colors.surface_container.default.rgba | set_alpha: 0.85 }}"
set index-active-fg "{{ colors.primary.default.rgba }}"

set completion-bg "{{ colors.surface_container.default.rgba | set_alpha: 0.85 }}"

set completion-highlight-bg "{{ colors.primary.default.rgba | set_alpha: 0.85 }}"

set completion-group-bg "{{ colors.surface.default.rgba | set_alpha: 0.85 }}"

set selection-clipboard clipboard
set incremental-search true
set search-hadjust true
set adjust-open width
set guioptions none

map [normal]     z zoom in
map [normal]     Z zoom out
map [fullscreen] z zoom in
map [fullscreen] Z zoom out

map [normal]     D toggle_page_mode
map [fullscreen] D toggle_page_mode

map [normal]     u scroll half-up
map [normal]     d scroll half-down
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down

map [normal]     f toggle_fullscreen
map [fullscreen] f toggle_fullscreen

map [normal]     <C-r> reload
map [fullscreen] <C-r> reload

map [normal]     b toggle_statusbar
map [fullscreen] b toggle_statusbar

map [normal]     H adjust_window best-fit
map [normal]     W adjust_window width
map [fullscreen] H adjust_window best-fit
map [fullscreen] W adjust_window width

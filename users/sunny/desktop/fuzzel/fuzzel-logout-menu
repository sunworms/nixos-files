SELECTION=$(cat <<EOF | fuzzel --dmenu --prompt "Power: " --lines 5 --width 20
󰌾 Lock
󰍃 Logout
󰒲 Suspend
󰜉 Reboot
󰐥 Power Off
EOF
)

case "$SELECTION" in
    *"Lock")
        gtklock ;;
    *"Logout")
        niri msg action quit --skip-confirmation ;;
    *"Suspend")
        systemctl suspend ;;
    *"Reboot")
        systemctl reboot ;;
    *"Power Off")
        systemctl poweroff ;;
esac

layout {
    focus-ring {
        active-color "#b4befe"
        inactive-color "#585b70"
        urgent-color "#f38ba8"
    }

    border {
        active-color "#b4befe"
        inactive-color "#585b70"
        urgent-color "#f38ba8"
    }

    shadow {
        color "#11111b40"
    }

    tab-indicator {
        active-color "#b4befe"
        inactive-color "#585b70"
        urgent-color "#f38ba8"
    }

    insert-hint {
        color "#b4befe80"
    }
}

overview {
    backdrop-color "#181825"
}

recent-windows {
    highlight {
        active-color "#b4befe"
        urgent-color "#f38ba8"
    }
}

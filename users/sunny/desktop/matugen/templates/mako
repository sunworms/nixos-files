# Matugen template for Mako (~/.config/mako/config)

font=D2CodingLigature Nerd Font Propo 10
background-color={{colors.surface_container_low.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.surface_container_high.default.hex}}
border-size=1
border-radius=6
padding=10,14
margin=8
default-timeout=5000
width=300
height=110

[urgency=high]
border-color={{colors.error.default.hex}}
default-timeout=0

[mode=do-not-disturb]
invisible=1
on-notify=none

[mode=silent]
on-notify=none

[app-name=osd]
border-color={{colors.surface_container_highest.default.hex}}
background-color={{colors.surface_container_low.default.hex}}
text-color={{colors.on_surface.default.hex}}
progress-color=over {{colors.surface_container_highest.default.hex}}
width=240
height=60
default-timeout=1500
anchor=top-right

# Catppuccin Mocha (Lavender Accent) for Zathura

set default-bg                      "rgba(30, 30, 46, 0.85)"     # Base
set render-loading-bg               "rgba(30, 30, 46, 0.85)"     # Base

set default-fg                      "rgba(205, 214, 244, 1)"    # Text

set statusbar-bg                    "rgba(49, 50, 68, 0.85)"     # Surface0
set statusbar-fg                    "rgba(180, 190, 254, 1)"    # Lavender

set inputbar-bg                      "rgba(49, 50, 68, 0.85)"     # Surface0
set inputbar-fg                      "rgba(180, 190, 254, 1)"    # Lavender

set index-bg                        "rgba(30, 30, 46, 0.85)"     # Base
set index-fg                        "rgba(205, 214, 244, 1)"    # Text

set index-active-bg                 "rgba(49, 50, 68, 0.85)"     # Surface0
set index-active-fg                 "rgba(180, 190, 254, 1)"    # Lavender

set completion-bg                   "rgba(49, 50, 68, 0.85)"     # Surface0
set completion-fg                   "rgba(205, 214, 244, 1)"    # Text

set completion-group-bg             "rgba(30, 30, 46, 0.85)"     # Base
set completion-group-fg             "rgba(147, 153, 178, 1)"    # Overlay0

set completion-highlight-bg         "rgba(180, 190, 254, 0.85)"  # Lavender
set completion-highlight-fg         "rgba(17, 17, 27, 1)"       # Crust

set notification-bg                 "rgba(49, 50, 68, 1)"        # Surface0
set notification-fg                 "rgba(205, 214, 244, 1)"    # Text

set notification-warning-bg         "rgba(249, 226, 175, 1)"    # Yellow
set notification-warning-fg         "rgba(17, 17, 27, 1)"       # Crust

set notification-error-bg           "rgba(243, 139, 168, 1)"    # Red
set notification-error-fg           "rgba(17, 17, 27, 1)"       # Crust

set highlight-color                 "rgba(180, 190, 254, 0.5)"   # Lavender (semi-transparent)
set highlight-active-color          "rgba(245, 194, 231, 0.5)"   # Pink (semi-transparent)

set highlight-fg                    "rgba(180, 190, 254, 1)"    # Lavender

set selection-clipboard clipboard
set incremental-search true
set search-hadjust true
set adjust-open width
set guioptions none

map [normal]     z zoom in
map [normal]     Z zoom out
map [fullscreen] z zoom in
map [fullscreen] Z zoom out

map [normal]     D toggle_page_mode
map [fullscreen] D toggle_page_mode

map [normal]     u scroll half-up
map [normal]     d scroll half-down
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down

map [normal]     f toggle_fullscreen
map [fullscreen] f toggle_fullscreen

map [normal]     <C-r> reload
map [fullscreen] <C-r> reload

map [normal]     b toggle_statusbar
map [fullscreen] b toggle_statusbar

map [normal]     H adjust_window best-fit
map [normal]     W adjust_window width
map [fullscreen] H adjust_window best-fit
map [fullscreen] W adjust_window width
